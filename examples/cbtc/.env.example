# examples/cbtc configuration. Copy to .env (gitignored) and fill in.
# The offline scripts need NETWORK only. Nothing here is a secret.

# mainnet | testnet | devnet
NETWORK=testnet

# Optional overrides, for a registry that has moved since the 2026-10-18 capture.
# Leave empty to use the values read from fixtures/registry/ (captured 2026-10-18).
REGISTRY_URL=
CBTC_ADMIN=

# --- pay, resolve, observe -------------------------------------------------------
# Your participant's JSON Ledger API, e.g. http://127.0.0.1:7575 or an SSH-forwarded port.
LEDGER_API_URL=
# The party that pays (pay, withdraw) or receives (resolve accept/reject, observe).
PARTY_ID=
# Set ONLY if PARTY_ID is an external party: the path to its Ed25519 private key (PEM).
# The key is read from the file to sign locally and is never sent or printed.
PARTY_KEY_FILE=
# Set ONLY if your participant requires auth: a file holding the bearer token.
LEDGER_TOKEN_FILE=
# The participant user the commands are submitted as.
LEDGER_USER_ID=ledger-api-user
# Where records, and the trust policy you derive, are written. Defaults to examples/cbtc/out (gitignored).
PAYVOL_OUT_DIR=
