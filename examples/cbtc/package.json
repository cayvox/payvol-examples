{
  "name": "@payvol/example-cbtc",
  "version": "0.0.0",
  "private": true,
  "description": "Payvol with CBTC: build, verify, pay and observe a CBTC payment request against the CBTC registry.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "refresh-metadata": "node dist/cli/refresh-metadata.js",
    "create-request": "node dist/cli/create-request.js",
    "verify-request": "node dist/cli/verify-request.js",
    "pay": "node dist/cli/pay.js",
    "instructions": "node dist/cli/instructions.js",
    "resolve": "node dist/cli/resolve.js",
    "trust-from-updates": "node dist/cli/trust-from-updates.js",
    "observe": "node dist/cli/observe.js"
  },
  "dependencies": {
    "@payvol/core": "^0.4.0",
    "@payvol/qr": "^0.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "@types/qrcode": "^1.5.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
